# Copy this file to `.env` and fill in real values for local development.
# `.env` itself is gitignored — never commit it. See docs/architecture/security.md
# for the full secrets-management strategy (Key Vault in the cloud, this
# file only for local dev).

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=CareerOS

# Used for JWT signing starting in a later milestone. Generate a real value
# locally with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-value-locally

# --- Database ----------------------------------------------------------------
# These POSTGRES_* values are consumed by the `postgres` service in
# docker-compose.yml; DATABASE_URL is what the API actually connects with
# and must match them.
POSTGRES_USER=careeros
POSTGRES_PASSWORD=changeme
POSTGRES_DB=careeros
DATABASE_URL=postgresql+asyncpg://careeros:changeme@postgres:5432/careeros

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- CORS ------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Job sources (Milestone 3) ------------------------------------------------
# Free credentials at https://developer.adzuna.com. Leave blank to run
# everything except POST /api/v1/jobs/ingest, which returns 503 without these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- AI provider (Milestone 5) ------------------------------------------------
# Get a key at https://console.anthropic.com. Leave blank to run everything
# except POST /api/v1/matches, which returns 503 without it. Verify
# ANTHROPIC_MODEL against https://docs.anthropic.com/en/docs/about-claude/models
# before deploying — model identifiers are versioned and change over time.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Document storage (Milestone 6) ---------------------------------------
# Local disk directory for generated resume/cover-letter PDFs — interim
# ahead of Azure Blob Storage. Mount this as a Docker volume if generated
# documents need to survive a container restart.
GENERATED_DOCUMENTS_DIR=generated_documents
